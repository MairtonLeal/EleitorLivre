# ── Dependências ──────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build do Next.js ──────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ── Testes / cobertura ────────────────────────
coverage/

# ── Variáveis de ambiente (nunca versionar segredos) ──
.env
.env*.local
!.env.example

# ── Deploy ────────────────────────────────────
.vercel/

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Sistema operacional / editores ────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Dados gerados em tempo de execução ────────
# (cache JSON do TSE, trilha de auditoria e perfis montados)
# O exemplo fictício em data/demo/ CONTINUA versionado.
data/cache/
data/auditoria/
data/perfis/
*.tmp

# ── Temporários desta sessão ──────────────────
_to_delete/
